{
  "name": "trace-js",
  "description": "Modular monorepo for all Hanzo JS/TS SDKs",
  "engines": {
    "node": ">=18"
  },
  "repository": "https://github.com/hanzoai/trace-js",
  "workspaces": [
    "hanzo-core",
    "hanzo-node",
    "hanzo",
    "hanzo-langchain",
    "hanzo-vercel",
    "integration-test/modules"
  ],
  "author": {
    "name": "Hanzo",
    "email": "hi@hanzo.com",
    "url": "https://hanzo.ai"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "yarn compile",
    "clean:build": "git clean -fdx -e node_modules -e .env && rm -rf node_modules && yarn install && yarn build",
    "lint": "eslint -c .eslintrc.cjs --fix hanzo*",
    "prettier": "prettier --write \"./**/*.{ts,tsx}\"",
    "prettier:check": "prettier --check \"./**/*.{ts,tsx}\"",
    "generateAPI": "yarn generateAPITypes && yarn generateAPIClient",
    "generateAPITypes": "openapi-typescript hanzo-core/openapi-spec/openapi-server.yaml --output hanzo-core/src/openapi/server.ts && openapi-typescript hanzo-core/openapi-spec/openapi-client.yaml --output hanzo-core/src/openapi/client.ts && yarn prettier",
    "generateAPIClient": "npx swagger-typescript-api@13.0.23 --path ./hanzo-core/openapi-spec/openapi-server.yaml --output ./hanzo/src --name publicApi.ts --api-class-name HanzoPublicApi --union-enums --unwrap-response-data --type-prefix Api --sort-routes --extract-request-params --extract-request-body",
    "test": "dotenv -- jest hanzo-core/* hanzo-node/* hanzo/*",
    "test:watch": "dotenv -- jest hanzo-core/* hanzo-node/* hanzo/* --watch --runInBand",
    "test:all": "dotenv -- jest hanzo-core/* hanzo-node/* hanzo/*",
    "test:core": "dotenv -- jest hanzo-core/*",
    "test:node": "dotenv -- jest hanzo-node/*",
    "test:fetch": "dotenv -- jest hanzo/*",
    "test:integration": "dotenv -- jest integration-test/* --verbose --runInBand",
    "test:langchain": "dotenv -- jest integration-test/hanzo-integration-langchain --verbose --runInBand",
    "test:datasets": "dotenv -- jest integration-test/hanzo-integration-datasets*",
    "test:node-integration": "dotenv -- jest integration-test/hanzo-integration-node*",
    "test:modules": "dotenv -- jest integration-test/hanzo-integration-modules*",
    "test:examples": "dotenv -- jest integration-test/hanzo-integration-examples*",
    "compile": "rollup -c --bundleConfigAsCjs",
    "docs": "yarn build && typedoc --options ./typedoc.config.cjs"
  },
  "devDependencies": {
    "@ai-sdk/openai": "catalog:",
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@langchain/core": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@rollup/plugin-babel": "catalog:",
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-json": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "ai": "catalog:",
    "axios": "catalog:",
    "babel-jest": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "husky": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "langchain": "catalog:",
    "lerna": "catalog:",
    "openai": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-delete": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-typescript2": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "yalc": "catalog:"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js,css,scss}": "prettier --write"
  },
  "packageManager": "pnpm@11.24.0"
}
